---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { getSite } from '../../site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter((project) => !project.data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, role, year, status, stack, repo, live, hero, gallery } = project.data;
const SITE = await getSite();
---

<Layout
  title={`${title} | ${SITE.name}`}
  description={summary}
  ogType="article"
>
  <article>
    <header>
      <p class="kicker">{year} &middot; {status}</p>
      <h1 class="page-title">{title}</h1>
    </header>

    <dl class="meta-grid">
      <div>
        <dt>Role</dt>
        <dd>{role}</dd>
      </div>
      <div>
        <dt>Year</dt>
        <dd>{year}</dd>
      </div>
      <div>
        <dt>Stack</dt>
        <dd>{stack.join(', ') || 'Not listed'}</dd>
      </div>
      <div>
        <dt>Links</dt>
        <dd>
          {repo && <a href={repo}>Repository</a>}
          {repo && live && ' \u00b7 '}
          {live && <a href={live}>Live</a>}
          {!repo && !live && 'None'}
        </dd>
      </div>
    </dl>

    {
      hero && (
        <Image
          class="project-hero"
          src={hero}
          alt={`${title} interface`}
          widths={[340, 680, 1024]}
          sizes="(max-width: 640px) 100vw, 680px"
        />
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      gallery.length > 0 && (
        <section aria-labelledby="gallery" class="project-gallery">
          <h2 id="gallery">Screens</h2>
          <ul>
            {gallery.map((shot) => (
              <li>
                <Image
                  src={shot}
                  alt={`${title} screen`}
                  widths={[340, 680, 1024]}
                  sizes="(max-width: 640px) 100vw, 680px"
                />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Layout>
