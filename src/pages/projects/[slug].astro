---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, role, year, status, stack, repo, live } = project.data;
---

<Layout
  title={`${title} | ${SITE.name}`}
  description={summary}
  ogType="article"
>
  <article>
    <header>
      <p class="kicker">{year} &middot; {status}</p>
      <h1 class="page-title">{title}</h1>
    </header>

    <dl class="meta-grid">
      <div>
        <dt>Role</dt>
        <dd>{role}</dd>
      </div>
      <div>
        <dt>Year</dt>
        <dd>{year}</dd>
      </div>
      <div>
        <dt>Stack</dt>
        <dd>{stack.join(', ') || 'Placeholder'}</dd>
      </div>
      <div>
        <dt>Links</dt>
        <dd>
          {repo && <a href={repo}>Repository</a>}
          {repo && live && ' \u00b7 '}
          {live && <a href={live}>Live</a>}
          {!repo && !live && 'Added by the content lane'}
        </dd>
      </div>
    </dl>

    <div class="prose">
      <Content />
    </div>
  </article>
</Layout>
