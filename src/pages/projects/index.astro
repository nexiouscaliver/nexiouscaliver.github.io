---
import Layout from '../../layouts/Layout.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { getCollection } from 'astro:content';
import { getSite } from '../../site';
import { showcase, contributions } from '../../data/showcase';

const SITE = await getSite();
const projects = (await getCollection('projects'))
  .filter((project) => !project.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const groups = [
  { key: 'product', label: 'Products' },
  { key: 'tooling', label: 'Tools' },
  { key: 'experiment', label: 'Experiments' },
  { key: 'library', label: 'Libraries' },
  { key: 'fork-adapted', label: 'Upstream forks' },
] as const;
---

<Layout
  title={`Projects | ${SITE.name}`}
  description="Software by Shahil Kadia: VoxBar, mission-control, OmniForge, AmiScheduler, a showcase of every public repo, and upstream contributions to pyWhat, mem0, CAMEL, Dify, and zimfarm."
>
  <header>
    <p class="kicker">Work</p>
    <h1 class="page-title">Projects</h1>
  </header>
  <ul class="project-list">
    {
      projects.map((project, i) => (
        <ProjectRow project={project} index={i + 1} />
      ))
    }
  </ul>
  {
    groups.map((group) => (
      <section>
        <div class="section-head">
          <h2>{group.label}</h2>
          <span class="count">{showcase[group.key].length}</span>
        </div>
        <ul class="showcase-list">
          {showcase[group.key].map((entry) => (
            <li class="showcase-row">
              <a href={entry.link}>
                <span class="name">{entry.name}</span>
                <span class="desc">{entry.description}</span>
                <span class="tags">{entry.tags.join(' \u00b7 ')}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  <section class="prose contrib">
    <h2>Open source</h2>
    <p>
      Pull requests to third-party repositories: five merged, seven still open.
      Titles are verbatim; follow a link for the current state of a change.
    </p>
    <h3 class="subhead">Merged upstream</h3>
    <ul class="contrib-list">
      {
        contributions.merged.map((pr) => (
          <li>
            <a href={pr.url}>
              <span class="repo">{pr.repo}</span>
              <span class="what">{pr.title}</span>
              <span class="when">{pr.when}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <h3 class="subhead">Open pull requests</h3>
    <ul class="contrib-list">
      {
        contributions.open.map((pr) => (
          <li>
            <a href={pr.url}>
              <span class="repo">{pr.repo}</span>
              <span class="what">{pr.title}</span>
              <span class="when">{pr.when}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
