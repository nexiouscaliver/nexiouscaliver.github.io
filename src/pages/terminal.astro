---
import Layout from '../layouts/Layout.astro';
import TermLine from '../components/TermLine.astro';
import {
  TERMINAL,
  FILES,
  type TermCommand,
  type TermFile,
  type TermLine,
} from '../data/terminal';
import { dump16 } from '../data/term-format';
import { createHash } from 'node:crypto';
import { statSync } from 'node:fs';
import { resolve } from 'node:path';
import { getSite, href } from '../site';
import pkg from '../../package.json';

const SITE = await getSite();
const SITE_URL = Astro.site ?? new URL('https://shahilkadia.me');
const PKG_VERSION: string = (pkg as { version?: string }).version ?? '0.1.0';

// Link tokens in the data resolve against site settings, so email, resume,
// and profiles have exactly one home.
const byHost = (host: string) =>
  SITE.links.find((link) => new URL(link).hostname.includes(host)) ?? '';

const TOKENS: Record<string, string> = {
  'site:resume': new URL(SITE.resume, SITE_URL).href,
  'site:email': `mailto:${SITE.email}?subject=[portfolio]%20`,
  'site:github': byHost('github.com'),
  'site:linkedin': byHost('linkedin.com'),
  'site:projects': new URL('/projects/', SITE_URL).href,
};

const resolveLine = (line: TermLine): TermLine =>
  'a' in line ? { ...line, href: TOKENS[line.href] ?? line.href } : line;

const serializeLine = (line: TermLine): TermLine | string =>
  'a' in line || line.c ? resolveLine(line) : line.t;

const CSP =
  "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline' 'self'; " +
  "connect-src 'none'; img-src 'none'; form-action 'none'; base-uri 'none'";

let RESUME_BYTES = 0;
try {
  RESUME_BYTES = statSync(
    resolve(process.cwd(), 'public/Shahil-Kadia-Resume.pdf')
  ).size;
} catch {}

// Files with link tokens resolved once, for both the island and the
// script-off transcript.
const filesResolved: TermFile[] = FILES.map((f) => ({
  ...f,
  size: f.path === 'resume.pdf' ? RESUME_BYTES : f.size,
  lines: f.lines?.map(resolveLine),
}));
// The island ships the same files with plain lines as bare strings.
const filesIsland = FILES.map((f) => ({
  ...f,
  size: f.path === 'resume.pdf' ? RESUME_BYTES : f.size,
  lines: f.lines?.map(serializeLine),
}));

// Island serialization: representative lines, examples, and flags stay in
// the uncounted static HTML for visible engine commands; hidden entries
// keep their refusal lines, as sudo ships today. The reward travels only
// as its base64 wrapper inside the reward.gpg file entry.
const islandCommands = TERMINAL.commands.map((c: TermCommand) => {
  const e: Record<string, unknown> = { name: c.name };
  if (c.action && c.action !== c.name) e.action = c.action;
  if (c.file) e.file = c.file;
  if (c.hidden) e.hidden = true;
  if (!c.hidden) {
    if (c.args) e.args = c.args;
    if (c.summary) e.summary = c.summary;
  }
  if ((!c.action || c.hidden) && c.lines) e.lines = c.lines.map(serializeLine);
  return e;
});

const data = {
  promptUser: TERMINAL.promptUser,
  promptHost: TERMINAL.promptHost,
  version: PKG_VERSION,
  banner: TERMINAL.banner,
  boot: TERMINAL.boot,
  intro: TERMINAL.intro,
  helpFlavor: TERMINAL.helpFlavor,
  files: filesIsland,
  commands: islandCommands,
};

// Serialized for the live terminal; < is escaped so the JSON island can
// never close its own script tag.
const dataJson = JSON.stringify(data).replace(/</g, '\\u003c');

// ---- script-off transcript ---------------------------------------------

const visible = TERMINAL.commands.filter((c) => !c.hidden);
const fileByPath = new Map(filesResolved.map((f) => [f.path, f]));
const keys = visible.map((c) => c.name + (c.args ? ' ' + c.args : ''));
const pad = Math.max(18, Math.max(...keys.map((k) => k.length)) + 2);
const helpRows = visible.map((c, i) => ({
  key: keys[i].padEnd(pad),
  summary: c.summary,
}));

// Generated static content, never hand-typed: the xxd and sha256 blocks
// come from term-format + node:crypto, the rest derive from the same data
// the engine reads, so the transcript cannot drift from the live terminal.
const rot13s = (s: string) =>
  s.replace(/[A-Za-z]/g, (ch) => {
    const b = ch <= 'Z' ? 65 : 97;
    return String.fromCharCode((ch.charCodeAt(0) - b + 13) % 26 + b);
  });
const b64visitor = Buffer.from('visitor', 'utf8').toString('base64');
const xxdVisitor = dump16(new TextEncoder().encode('visitor')).map(
  (t) => ({ t }) as TermLine
);
const shaVisitor = createHash('sha256')
  .update('visitor', 'utf8')
  .digest('hex')
  .slice(0, 12);

const contentText = (f?: TermFile) =>
  (f?.lines ?? []).map((l) => ('a' in l ? l.a : l.t)).join('\n');
const aboutFile = fileByPath.get('about.md');
const aboutText = contentText(aboutFile);
const wcAbout = `${aboutFile?.lines?.length ?? 0} ${
  aboutText.split(/\s+/).filter(Boolean).length
} ${Buffer.byteLength(aboutText, 'utf8') + 1} about.md`;
const contactLines = fileByPath.get('contact.txt')?.lines ?? [];

const dirSet = new Set<string>();
FILES.forEach((f) => {
  const i = f.path.lastIndexOf('/');
  if (i >= 0) dirSet.add(f.path.slice(0, i));
});
const hesc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const lsHtml = [...new Set(FILES.map((f) => f.path.split('/')[0]))]
  .sort()
  .filter((n) => !n.startsWith('.'))
  .map((n) => {
    const d = dirSet.has(n);
    const cls = d ? 'bright' : n === 'resume.pdf' ? 'amber' : '';
    const lab = hesc(n) + (d ? '/' : '');
    return cls ? `<span class="${cls}">${lab}</span>` : lab;
  })
  .join('  ');

const manFor = (name: string): TermLine[] => {
  const c = TERMINAL.commands.find((x) => x.name === name);
  if (!c) return [];
  const u = name.toUpperCase() + '(1)';
  const head =
    u + ' '.repeat(Math.max(2, 30 - u.length)) +
    'Shahil Kadia' + ' '.repeat(Math.max(2, 30 - 12)) + u;
  return [
    { t: head, c: 'bright' },
    { t: '' },
    { t: 'NAME', c: 'bright' },
    { t: '     ' + c.name + ' - ' + c.summary },
    { t: '' },
    { t: 'SYNOPSIS', c: 'bright' },
    { t: '     ' + c.name + (c.args ? ' ' + c.args : '') },
    { t: '' },
    { t: 'DESCRIPTION', c: 'bright' },
    { t: '     ' + c.summary },
    { t: '' },
    { t: 'BUGS', c: 'bright' },
    { t: '     ' + TERMINAL.helpFlavor.bugs },
  ];
};

const GENERATED: Record<string, TermLine[]> = {
  man: manFor('ls'),
  base64: [{ t: b64visitor }],
  rot13: [
    { t: rot13s('visitor') },
    { t: 'rot13 is its own inverse, so the same command decodes this', c: 'dim' },
  ],
  xxd: xxdVisitor,
  sha256: [{ t: 'SHA2-256 (visitor) = ' + shaVisitor }],
  wc: [{ t: wcAbout }],
  head: contactLines.slice(0, 3),
  echo: [{ t: 'visitor' }],
  whoami: [{ t: 'visitor' }],
  pwd: [{ t: '/home/visitor', c: 'dim' }],
};

const staticLines = (c: TermCommand): TermLine[] =>
  GENERATED[c.name] ??
  (c.action === 'cat' && (c.file ?? c.example)
    ? (fileByPath.get(c.file ?? c.example)?.lines ?? [])
    : (c.lines ?? []));
---

<Layout
  title={`Terminal | ${SITE.name}`}
  description="A keyboard-first corner of the portfolio. A read-only home you can cat, cd, and look around, plus one locked drawer. Same facts as the rest of the site, minus the mouse."
  chrome={false}
  bodyClass="term-root"
>
  <Fragment slot="head">
    <meta http-equiv="Content-Security-Policy" content={CSP} />
  </Fragment>
  <div class="term">
    <a class="term-exit" href={href('/')}>[ back to the site ]</a>

    <!-- Script-off fallback: the same content the commands print, rendered
         statically. The live terminal hides this and takes over. -->
    <div id="term-static">
      <h1 class="t-h1">Terminal</h1>
      <p class="t-line dim">
        scripting is off, so this is the same terminal as a plain transcript.
        the live one, caret and all, needs JavaScript.
      </p>
      <pre class="t-banner">{TERMINAL.banner.join('\n')}</pre>
      {TERMINAL.intro.map((line) => <TermLine line={line} />)}
      {
        visible.map((c) => (
          <section class="t-block">
            <p class="t-cmd">
              <span class="ps1">
                {TERMINAL.promptUser}@{TERMINAL.promptHost}:<span class="path">~</span>$
              </span>{' '}
              {c.name}{c.example ? ` ${c.example}` : ''}
            </p>
            {c.name === 'help' ? (
              <>
                <p class="t-line bright">{TERMINAL.helpFlavor.header}</p>
                <p class="t-line">{'\u00a0'}</p>
                <p class="t-line bright">NAME</p>
                <p class="t-line">{'     ' + TERMINAL.helpFlavor.name}</p>
                <p class="t-line">{'\u00a0'}</p>
                <p class="t-line bright">COMMANDS</p>
                {helpRows.map((row) => (
                  <p class="t-line">
                    <span class="amber">{'     ' + row.key}</span>
                    {row.summary}
                  </p>
                ))}
                <p class="t-line">{'\u00a0'}</p>
                <p class="t-line bright">FILES</p>
                {TERMINAL.helpFlavor.files.map((f) => (
                  <p class="t-line">{'     ' + f}</p>
                ))}
                <p class="t-line">{'\u00a0'}</p>
                <p class="t-line bright">BUGS</p>
                <p class="t-line">{'     ' + TERMINAL.helpFlavor.bugs}</p>
              </>
            ) : c.action === 'clear' ? (
              <p class="t-line dim">{'(wipes the screen in the live terminal)'}</p>
            ) : c.name === 'ls' ? (
              <p class="t-line" set:html={lsHtml} />
            ) : (
              staticLines(c).map((line) => <TermLine line={line} />)
            )}
          </section>
        ))
      }
    </div>

    <div id="term-live" hidden>
      <div id="out" role="log" aria-live="polite"></div>
      <div class="pline" id="pline">
        <span class="ps1" id="ps1"></span><span id="pre"></span><span
          class="caret"
          id="caret">&nbsp;</span
        ><span id="post"></span><span class="ghost" id="ghost"></span>
      </div>
    </div>

    <!-- The real input: 1px and invisible, so mobile keyboards and IMEs work
         while the rendered prompt above shows the caret. -->
    <input
      id="kbd"
      autocomplete="off"
      autocapitalize="off"
      autocorrect="off"
      spellcheck="false"
      aria-label="Terminal input. Type help for the command list."
    />
  </div>

  <script is:inline type="application/json" id="term-data" set:html={dataJson} />

  <script is:inline>
(function () {
var D = document;
var dataEl = D.getElementById('term-data'), staticEl = D.getElementById('term-static'), liveEl = D.getElementById('term-live');
if (!dataEl || !staticEl || !liveEl) return;
var T; try { T = JSON.parse(dataEl.textContent || '{}'); } catch (e) { return; }
staticEl.hidden = true; liveEl.hidden = false;
var $out = D.getElementById('out'), $kbd = D.getElementById('kbd'), $ps1 = D.getElementById('ps1'), $pre = D.getElementById('pre'), $post = D.getElementById('post'), $caret = D.getElementById('caret'), $ghost = D.getElementById('ghost'), $pline = D.getElementById('pline');
var RM = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
var M = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return M[c]; }); }
var CK = /^(dim|bright|amber|err|ok)$/, HC = /^(https?:|mailto:)/;
function SB() { $out.scrollTop = $out.scrollHeight; }
function P(html, cls) { var d = D.createElement('div'); if (cls) d.className = cls; d.innerHTML = html || '\u00a0'; $out.appendChild(d); SB(); return d; }
function PT(t, cls) { return P(t === '' ? '\u00a0' : esc(t), cls); }
function LH(l) {
if (typeof l === 'string') return esc(l);
var cls = l.c && CK.test(l.c) ? l.c : '';
if (l.a !== undefined) {
var h = HC.test(l.href) ? l.href : '';
if (!h) return cls ? '<span class="' + cls + '">' + esc(l.a) + '</span>' : esc(l.a);
return '<a href="' + esc(h) + '"' + (/^https?:/.test(h) ? ' target="_blank" rel="noopener"' : '') + '>' + esc(l.a) + '</a>';
}
return cls ? '<span class="' + cls + '">' + esc(l.t || '') + '</span>' : esc(l.t || '');
}
function PL(l) { P(LH(l)); }
function sleep(ms) { return RM ? Promise.resolve() : new Promise(function (r) { setTimeout(r, ms); }); }
var cmds = T.commands || [], vis = cmds.filter(c => !c.hidden);
var names = vis.map(c => c.name).sort();
var byName = new Map(); cmds.forEach(function (c) { byName.set(c.name, c); });
var byPath = new Map(); (T.files || []).forEach(function (f) { byPath.set(f.path, f); });
var HOME = '/home/visitor', cwd = '', user = T.promptUser || 'visitor', st = 0, inc = 0, MTIME = 'Oct 12 12:00';
var UNAME = 'phosphor ' + T.promptHost + ' 1.0 READ-ONLY arm64', EXIT = '/', PIN = '13be455a';
var busy = false, seq = 0, AB = {};
function tx(tk, t, cls) { if (tk !== seq) throw AB; PT(t, cls); }
function strm(fn) {
busy = true; $out.setAttribute('aria-busy', 'true'); var tk = ++seq;
function done() { if (tk === seq) { busy = false; $out.removeAttribute('aria-busy'); } RP(); }
fn(tk).then(done, done);
}
function ft(l) { return typeof l === 'string' ? l : l.a !== undefined ? l.a : l.t; }
function ct(f) { return f.lines ? f.lines.map(ft).join('\n') : ''; }
function bz(f) { if (!f) return 0; if (f.size != null) return f.size; if (f.payload) return f.payload.length; return f.lines ? ct(f).length + 1 : 0; }
function rp(p) {
p = String(p == null ? '' : p).trim();
if (p[0] === '~') { if (p.length === 1) return ''; p = HOME + p.slice(1); }
if (p[0] === '/') { if (p === '/') return ''; if (p.indexOf(HOME) !== 0) return null; p = p.slice(HOME.length); }
else if (!p) return '';
else p = (cwd ? '/' + cwd : '') + '/' + p;
var a = [];
p.split('/').forEach(function (s) { if (!s || s === '.') return; if (s === '..') { if (a.length) a.pop(); return; } a.push(s); });
return a.join('/');
}
function dd(p) {
if (p === '') return true;
if (byPath.has(p)) return false;
var pre = p + '/', hit = false;
byPath.forEach((f, k) => { if (!hit && k.startsWith(pre)) hit = true; });
return hit;
}
function ld(d) {
var pre = d ? d + '/' : '', o = [];
byPath.forEach(function (f, k) {
if (k.indexOf(pre) !== 0) return;
var r = k.slice(pre.length); if (!r) return;
var s = r.indexOf('/'); o.push(s === -1 ? r : r.slice(0, s));
});
return o.filter(function (v, i) { return o.indexOf(v) === i; }).sort();
}
function jn(d, n) { return d ? d + '/' + n : n; }
function p1() { return esc(user) + '@' + esc(T.promptHost) + ':<span class="path">~' + (cwd ? '/' + esc(cwd) : '') + '</span>$'; }
function ppl(cmd) { P('<span class="ps1">' + p1() + '</span> ' + esc(cmd)); }
var SK=''.match(/.{8}/g).map(function (x) { return parseInt(x, 16); });
function sha(s) {
var b = new TextEncoder().encode(s), l = b.length, p = new Uint8Array((((l + 8) >> 6) + 1) << 6);
p.set(b); p[l] = 0x80;
var dv = new DataView(p.buffer);
dv.setUint32(p.length - 8, l >>> 29); dv.setUint32(p.length - 4, (l << 3) >>> 0);
var H = [0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19], W = new Uint32Array(64);
for (var o = 0; o < p.length; o += 64) {
var j, q;
for (j = 0; j < 16; j++) W[j] = dv.getUint32(o + 4 * j);
for (q = 16; q < 64; q++) {
var w = W[q - 15], u = W[q - 2];
var s0 = ((w >>> 7) | (w << 25)) ^ ((w >>> 18) | (w << 14)) ^ (w >>> 3);
var s1 = ((u >>> 17) | (u << 15)) ^ ((u >>> 19) | (u << 13)) ^ (u >>> 10);
W[q] = (W[q - 16] + s0 + W[q - 7] + s1) >>> 0;
}
var a = H[0], b2 = H[1], c = H[2], d = H[3], e = H[4], f = H[5], g = H[6], h = H[7];
for (var r = 0; r < 64; r++) {
var S1 = ((e >>> 6) | (e << 26)) ^ ((e >>> 11) | (e << 21)) ^ ((e >>> 25) | (e << 7));
var ch = (e & f) ^ (~e & g), t1 = (h + S1 + ch + SK[r] + W[r]) >>> 0;
var S0 = ((a >>> 2) | (a << 30)) ^ ((a >>> 13) | (a << 19)) ^ ((a >>> 22) | (a << 10));
var mj = (a & b2) ^ (a & c) ^ (b2 & c), t2 = (S0 + mj) >>> 0;
h = g; g = f; f = e; e = (d + t1) >>> 0; d = c; c = b2; b2 = a; a = (t1 + t2) >>> 0;
}
H[0]=(H[0]+a)>>>0;H[1]=(H[1]+b2)>>>0;H[2]=(H[2]+c)>>>0;H[3]=(H[3]+d)>>>0;H[4]=(H[4]+e)>>>0;H[5]=(H[5]+f)>>>0;H[6]=(H[6]+g)>>>0;H[7]=(H[7]+h)>>>0;
}
var out = ''; for (var x = 0; x < 8; x++) out += (H[x] >>> 0).toString(16).padStart(8, '0');
return out;
}
function b64e(s) { var b = new TextEncoder().encode(s), x = ''; for (var i = 0; i < b.length; i++) x += String.fromCharCode(b[i]); return btoa(x); }
function b64d(s) { var x = atob(s), b = new Uint8Array(x.length); for (var i = 0; i < x.length; i++) b[i] = x.charCodeAt(i); return new TextDecoder().decode(b); }
function sh(s, n) { n = ((n % 26) + 26) % 26; return s.replace(/[A-Za-z]/g, c => { var b = c <= 'Z' ? 65 : 97; return String.fromCharCode((c.charCodeAt(0) - b + n) % 26 + b); }); }
