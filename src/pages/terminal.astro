  .term .bright {
    color: #4dff7a;
  }

  .term .amber,
  .term a {
    color: #ffb454;
  }

  .term .err {
    color: #ff6b6b;
  }

  .term .ok {
    color: #4dff7a;
  }

  .term a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #term-static {
    flex: 1;
    min-height: 0;
    /* Top clearance so the fixed exit link starts clear of content. */
    padding-top: 2.75rem;
    /* Bottom comfort lives inside the scroller (it scrolls with content)
