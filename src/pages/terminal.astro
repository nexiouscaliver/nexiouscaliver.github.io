    padding-bottom: 0.75rem;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #1d3a26 transparent;
  }

  #term-live {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    /* The prompt line keeps its clearance above the frame edge. */
    padding-bottom: 1.75rem;
  }

  #term-live[hidden] {
    display: none;
  }

  #out {
    flex: 1;
    min-height: 0;
    /* Top clearance so the fixed exit link starts clear of content. */
    padding-top: 2.75rem;
    overflow-y: auto;
    white-space: pre-wrap;
    word-break: break-word;
    scrollbar-width: thin;
    scrollbar-color: #1d3a26 transparent;
