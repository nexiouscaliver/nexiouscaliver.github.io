    height: 100svh;
    display: flex;
    flex-direction: column;
    max-width: 56.25rem;
    margin: 0 auto;
    /* No bottom padding: the script-off transcript must meet the frame edge
       so its scroll fold never slices a glyph above dead space. The live
       layout carries its own bottom padding below the prompt line. */
    padding: 1rem 1.25rem 0;
    font-family: var(--font-mono);
    font-size: 15px;
    line-height: 1.5;
