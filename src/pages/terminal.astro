var o = [];
for (var i = 0; i < bs.length; i += 16) {
var hx = '', as = '';
for (var g = 0; g < 8; g++) {
var a = bs[i + 2 * g], b = bs[i + 2 * g + 1];
hx += (g ? ' ' : '') + (a == null ? '  ' : (a < 16 ? '0' : '') + a.toString(16)) + (b == null ? '  ' : (b < 16 ? '0' : '') + b.toString(16));
}
for (var j = i; j < i + 16 && j < bs.length; j++) { var c = bs[j]; as += c >= 0x20 && c <= 0x7e ? String.fromCharCode(c) : '.'; }
o.push(i.toString(16).padStart(4, '0') + ': ' + hx + '  ' + as);
}
return o;
}
function noi(n) { PT(n + ': (stdin): this page cannot accept piped stdin, name a file', 'dim'); st = 1; }
function catF(a, c) {
var arg = a.ops[0] != null ? a.ops[0] : c && c.file ? c.file : null;
if (arg == null) { noi('cat'); return; }
var p = rp(arg);
if (p === null || (p !== '' && !byPath.has(p) && !dd(p))) { PT('cat: ' + arg + ': No such file or directory', 'err'); st = 1; return; }
if (p === '' || dd(p)) { PT('cat: ' + arg + ': Is a directory', 'err'); st = 1; return; }
var f = byPath.get(p);
if (f.bin) {
PT('cat: ' + arg + ': binary file' + (f.path === 'resume.pdf' ? ' (try the resume command)' : ''));
if (f.payload) PT('(this drawer does not open by being read)', 'dim');
st = 1; return;
}
(f.lines || []).forEach(PL); st = 0;
}
function lsC(fp, n) { if (dd(fp)) return n[0] === '.' ? 'dim' : 'bright'; if (n === 'resume.pdf') return 'amber'; return n[0] === '.' ? 'dim' : ''; }
function lsF(a) {
var arg = a.ops[0] || '', p = arg ? rp(arg) : cwd, base = p, one = null;
if (p === null) { PT('ls: ' + (arg || '.') + ': No such file or directory', 'err'); st = 1; return; }
if (p !== '' && !dd(p)) {
if (byPath.has(p)) { var ix = p.lastIndexOf('/'); base = ix === -1 ? '' : p.slice(0, ix); one = p.slice(base ? base.length + 1 : 0); }
else { PT('ls: ' + (arg || '.') + ': No such file or directory', 'err'); st = 1; return; }
}
var ents = one ? [one] : ld(p);
if (!a.flags.a && !one) ents = ents.filter(n => n[0] !== '.');
if (!ents.length) { st = 0; return; }
if (a.flags.l) {
ents.forEach(function (n) {
var fp = jn(base, n), d = dd(fp), cls = lsC(fp, n);
var body = (d ? 'dr-xr-xr-x' : '-r--r--r--') + '  1 visitor  shahilkadia  ' + String(d ? 512 : bz(byPath.get(fp))).padStart(7) + '  ' + MTIME + '  ' + n;
P(cls ? '<span class="' + cls + '">' + esc(body) + '</span>' : esc(body));
});
} else {
P(ents.map(function (n) {
var fp = jn(base, n), cls = lsC(fp, n), lab = esc(n) + (dd(fp) ? '/' : '');
return cls ? '<span class="' + cls + '">' + lab + '</span>' : lab;
}).join('  '));
}
st = 0;
}
function cdF(a) {
var arg = a.ops[0];
if (arg == null) { cwd = ''; st = 0; return; }
var p = rp(arg);
if (p === null || !dd(p)) { PT('cd: no such file or directory: ' + arg, 'err'); st = 1; return; }
cwd = p; st = 0;
}
function headF(a) {
var arg = a.ops[0];
if (arg == null) { noi('head'); return; }
var f = byPath.get(rp(arg));
if (!f || !f.lines) { PT("head: cannot open '" + arg + "' for reading: No such file or directory", 'err'); st = 1; return; }
var n = a.flags.n != null ? parseInt(a.flags.n, 10) : 10;
if (!(n > 0)) n = 10;
f.lines.slice(0, n).forEach(PL); st = 0;
}
function wcF(a) {
var arg = a.ops[0];
if (arg == null) { noi('wc'); return; }
var f = byPath.get(rp(arg));
if (!f) { PT('wc: ' + arg + ': No such file or directory', 'err'); st = 1; return; }
